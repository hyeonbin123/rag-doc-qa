DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
# 토큰 서명 키. 아래 공개 예시 값 그대로면 누구나 로그인 토큰을 만들 수 있으므로, 복사한 뒤 반드시
# python -c "import secrets; print(secrets.token_urlsafe(48))"로 만든 값(32바이트 이상)으로 바꾼다. 예시 값이나
# 짧은 값이면 서버가 시작할 때 큰 경고를 남기고, APP_ENV=production이면 시작하지 않는다.
JWT_SECRET_KEY=change-me-to-a-random-secret
# development(기본) 또는 production. production은 약한 JWT_SECRET_KEY로 시작하지 않고, /docs·/redoc 화면도
# 끈다(/openapi.json은 남김). 다른 기기에서 접속하게 열 때(HOST_BIND_ADDRESS=0.0.0.0)는 production으로 둔다.
APP_ENV=development
# 토큰 서명 알고리즘. HS256(기본)·HS384·HS512만 받고, 그 밖의 값이면 서버가 시작하지 않는다. JWT_SECRET_KEY의
# 최소 길이는 알고리즘의 해시 길이(HS256 32, HS384 48, HS512 64바이트)다.
JWT_ALGORITHM=HS256
# 접근 토큰 수명(분)과 갱신 토큰 수명(일). 1 이상이어야 한다(0 이하면 서버가 시작하지 않는다).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 답변 생성기. "ollama"(기본)는 로컬에서 무료로 생성하고, "anthropic"은 Claude API를 쓴다(API 크레딧 필요).
GENERATION_PROVIDER=ollama
# GENERATION_PROVIDER=anthropic일 때만 읽는다. ollama를 쓰는 동안은 비워 둔다. docker compose는 env_file로 이 파일의
# 모든 값을 API 컨테이너 환경에 넣으므로, 쓰지 않는 키도 docker inspect 등으로 보이게 된다(ZAP 스캔 대상은
# zap/compose.scan.yml이 빈 값으로 덮어쓴다).
ANTHROPIC_API_KEY=
# Claude 경로는 도구 호출을 강제하는 tool_choice에 기대는 설계라 claude-sonnet-5 세대에서만 맞는다. Claude Sonnet
# 5.5·Opus 5.5·Fable 5.1은 강제 tool_choice를 400으로 거부하므로 이 값만 바꾸면 깨진다(README '알려진 한계').
CLAUDE_MODEL_NAME=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
# v13에서 채택한 생성 모델 A.X-4.0-Light(docs/experiments.md). Ollama 라이브러리에 없어
# scripts/ax40_light/로 직접 만든다(README). 없으면 qwen2.5:7b-instruct(`ollama pull`로 받음)를 쓴다. v12까지의
# 생성 모델이고, 평가의 판정 모델(J1)로도 쓴다.
OLLAMA_MODEL_NAME=a.x-4.0-light:q4_k_m
# 한국어 답의 코드 밖 본문에 한자·가나가 섞이면(중국어·일본어로 샘) 한 번 다시 생성한다(v13부터 켬).
LANGUAGE_GUARD=true
# '문서에 내용이 없다'는 거절 답에는 인용을 붙이지 않는다(v15부터 켬). false면 예전처럼 거절에도 인용이 붙는다.
EMPTY_CITATIONS_ON_REFUSAL=true
# 답할 근거가 없을 때의 거절 지시. legacy(기본)는 지금 프롬프트("say you don't know")이고, fixed는 언어별 고정
# 거절문("I don't know: …", '모르겠습니다. …')을 그대로 쓰게 하는 후보다(docs/experiments.md v16-B). 측정으로
# 채택되기 전에는 legacy로 둔다. 다른 값이면 서버가 시작하지 않는다.
REFUSAL_STYLE=legacy
# 선택 설정이고 기본은 두지 않는다. OLLAMA_THINK=false면 기본으로 추론(think)하는 모델(qwen3.5)의 추론을
# 끈다.
# OLLAMA_THINK=false
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# 한국어 문서와 질문은 따로 다국어 모델을 쓴다(청크를 언어별로 임베딩). v13 단계 B부터 granite-311m(고정
# 리비전, 384차원으로 자름)이고, 그 전까지 쓰던 intfloat/multilingual-e5-small도 이미지에 들어 있다. 바꾸면
# 다음 적재 때 한국어 문서를 다시 임베딩한다.
EMBEDDING_MODEL_NAME_KO=ibm-granite/granite-embedding-311m-multilingual-r2
# 검색 방식. "dense"(기본), "hybrid"(dense + Postgres 전문 검색 BM25를 가중 RRF로 합침), "rerank"(dense +
# BM25 후보를 cross-encoder가 다시 채점). 측정한 장단점은 README에 있다.
RETRIEVAL_MODE=dense
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# rerank 모드의 한국어 질문은 다국어 cross-encoder를 쓴다(위 모델은 영어 전용).
RERANKER_MODEL_NAME_KO=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# CPU를 쓰는 모델 호출(임베딩, 재정렬)을 돌리는 작업 스레드 수(app/services/inference.py).
# 1 이상이어야 한다(0 이하면 서버가 시작하지 않는다).
MODEL_THREADS=6
# 적재(CLI --commit, 관리자 API commit_sha)가 ref를 주지 않았을 때 적재할 tiangolo/fastapi의 브랜치·태그·커밋 SHA.
# 비워 두면 측정에 쓴 문서 스냅숏 커밋(50113da…, README '3. 문서 수집')을 적재한다(README 수치와 같은 코퍼스).
# 최신 문서를 늘 받으려면 master를 넣는다. 어느 값이든 GitHub에 물어 40자 커밋 SHA로 바꾼 뒤 쓴다.
# ref 형식(영숫자·'.'·'_'·'-'와 안쪽 '/', '..'이나 점으로 시작하는 조각 없음, 100자 이하)이 아니면 서버와 적재
# 명령이 시작하지 않는다.
FASTAPI_DOCS_COMMIT_SHA=
# 관리자 적재 API(POST /admin/documents/ingest, X-Admin-Token 헤더)의 토큰. 비워 두면 그 API가 꺼진다(403).
# 쓰려면 python -c "import secrets; print(secrets.token_urlsafe(32))"로 만든 값을 넣는다. CLI 적재
# (python -m scripts.ingest_fastapi_docs)는 이 토큰이 필요 없다.
ADMIN_INGEST_TOKEN=
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
# docker compose가 DB를 게시할 호스트 포트. 5432를 쓸 수 없으면 이 값과 DATABASE_URL의 포트를 함께 바꾼다.
POSTGRES_HOST_PORT=5432
# docker compose가 API(8000) 포트를 게시할 호스트 주소. 기본 127.0.0.1은 이 PC에서만 접속된다. 같은 네트워크의
# 다른 기기에서 열어야 할 때만 0.0.0.0으로 바꾸고, 그 전에 JWT_SECRET_KEY를 바꾸고 APP_ENV=production을 둔다.
HOST_BIND_ADDRESS=127.0.0.1
# docker compose가 DB 포트(POSTGRES_HOST_PORT)를 게시할 호스트 주소. HOST_BIND_ADDRESS와 따로라 API를 0.0.0.0으로
# 열어도 DB는 이 PC에서만 접속된다. DB까지 열어야 할 때만 바꾸고, 그 전에 DB 비밀번호를 바꾼다(README).
DB_BIND_ADDRESS=127.0.0.1
