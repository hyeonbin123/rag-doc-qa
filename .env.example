DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# "ollama" runs generation locally for free; "anthropic" uses the Claude API (needs credits).
GENERATION_PROVIDER=ollama
ANTHROPIC_API_KEY=
CLAUDE_MODEL_NAME=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Korean docs and questions use their own multilingual model (chunks are embedded per language).
EMBEDDING_MODEL_NAME_KO=intfloat/multilingual-e5-small
# "dense" (default), "hybrid" (dense + BM25 over Postgres full-text, fused with weighted RRF),
# or "rerank" (cross-encoder re-scores the dense + BM25 candidates). README has the measured trade-offs.
RETRIEVAL_MODE=dense
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Korean questions in rerank mode use a multilingual cross-encoder (the one above is English-only).
RERANKER_MODEL_NAME_KO=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Worker threads for CPU-bound model calls (embeddings, reranker); see app/services/inference.py.
MODEL_THREADS=6
FASTAPI_DOCS_COMMIT_SHA=
ADMIN_INGEST_TOKEN=change-me-admin-token
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
# Host port docker compose publishes the DB on; change it (and the port in DATABASE_URL) if 5432 is taken.
POSTGRES_HOST_PORT=5432
