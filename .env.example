DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
# 토큰 서명 키. 아래 공개 예시 값 그대로면 누구나 로그인 토큰을 만들 수 있으므로, 복사한 뒤 반드시
# python -c "import secrets; print(secrets.token_urlsafe(48))"로 만든 값(32바이트 이상)으로 바꾼다. 예시 값이나
# 짧은 값이면 서버가 시작할 때 큰 경고를 남기고, APP_ENV=production이면 시작하지 않는다.
JWT_SECRET_KEY=change-me-to-a-random-secret
# development(기본) 또는 production. production은 약한 JWT_SECRET_KEY로 시작하지 않는다.
APP_ENV=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# "ollama" runs generation locally for free; "anthropic" uses the Claude API (needs credits).
GENERATION_PROVIDER=ollama
ANTHROPIC_API_KEY=
CLAUDE_MODEL_NAME=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
# A.X-4.0-Light, adopted in v13 (docs/experiments.md). It is not in the Ollama library: build it
# with scripts/ax40_light/ (README). Without it, use qwen2.5:7b-instruct (`ollama pull`), the
# generator up to v12 and still the evaluation judge.
OLLAMA_MODEL_NAME=a.x-4.0-light:q4_k_m
# Regenerates a Korean answer once if it slips into Chinese or Japanese (on since v13).
LANGUAGE_GUARD=true
# Optional, unset by default: OLLAMA_THINK=false turns off the reasoning of models that think by
# default (qwen3.5).
# OLLAMA_THINK=false
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Korean docs and questions use their own multilingual model (chunks are embedded per language).
# granite-311m (pinned revision, cut to 384 dimensions) since v13 stage B; intfloat/multilingual-e5-small,
# the model up to then, is still in the image. Changing it re-embeds the Korean docs on the next ingest.
EMBEDDING_MODEL_NAME_KO=ibm-granite/granite-embedding-311m-multilingual-r2
# "dense" (default), "hybrid" (dense + BM25 over Postgres full-text, fused with weighted RRF),
# or "rerank" (cross-encoder re-scores the dense + BM25 candidates). README has the measured trade-offs.
RETRIEVAL_MODE=dense
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Korean questions in rerank mode use a multilingual cross-encoder (the one above is English-only).
RERANKER_MODEL_NAME_KO=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Worker threads for CPU-bound model calls (embeddings, reranker); see app/services/inference.py.
MODEL_THREADS=6
# 지금 코드는 이 값을 읽지 않는다. 적재할 커밋은 CLI의 --commit이나 관리자 API의 commit_sha로 정하고, 없으면
# tiangolo/fastapi master의 최신 커밋을 쓴다.
FASTAPI_DOCS_COMMIT_SHA=
# 관리자 적재 API(POST /admin/documents/ingest, X-Admin-Token 헤더)의 토큰. 비워 두면 그 API가 꺼진다(403).
# 쓰려면 python -c "import secrets; print(secrets.token_urlsafe(32))"로 만든 값을 넣는다. CLI 적재
# (python -m scripts.ingest_fastapi_docs)는 이 토큰이 필요 없다.
ADMIN_INGEST_TOKEN=
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
# Host port docker compose publishes the DB on; change it (and the port in DATABASE_URL) if 5432 is taken.
POSTGRES_HOST_PORT=5432
# docker compose가 API(8000)와 DB 포트를 게시할 호스트 주소. 기본 127.0.0.1은 이 PC에서만 접속된다. 같은
# 네트워크의 다른 기기에서 열어야 할 때만 0.0.0.0으로 바꾸고, 그 전에 JWT_SECRET_KEY와 DB 비밀번호를 바꾼다.
HOST_BIND_ADDRESS=127.0.0.1
